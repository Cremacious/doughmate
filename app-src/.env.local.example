# App ids identify the app to AdMob. Unit ids identify the individual banner.
# Both are needed: without the banner unit ids the app falls back to Google's
# test units, which render ads but earn nothing.
EXPO_PUBLIC_ADMOB_APP_ID_IOS=ca-app-pub-xxx
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=ca-app-pub-xxx
EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-xxx/xxx
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-xxx/xxx
# Devices that get test ads even against the real unit ids. Find the id in the
# device log on first launch. Comma separated; use EMULATOR for simulators.
# Set this on any build where you hold the phone and the real ids are active.
EXPO_PUBLIC_ADMOB_TEST_DEVICE_ID=
EXPO_PUBLIC_REVENUECAT_KEY_IOS=appl_xxx
EXPO_PUBLIC_REVENUECAT_KEY_ANDROID=goog_xxx
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN_IOS=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN_ANDROID=https://xxx@xxx.ingest.sentry.io/xxx
